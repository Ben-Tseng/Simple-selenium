{
  "manifest_version": 2,
  "name": "Tab Rule Runner",
  "version": "2.0.0",
  "description": "遍历全部窗口全部Tab，命中关键字后执行预设脚本",
  "browser_action": {
    "default_title": "Tab Rule Runner",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["tabs", "storage", "<all_urls>"]
}
